{
  "name": "pii-protect/monolog-handler",
  "description": "Monolog handler that anonymizes PII in log records via PII Protect engine",
  "type": "library",
  "license": "MIT",
  "keywords": ["monolog", "pii", "privacy", "logging", "anonymization"],
  "require": {
    "php": ">=8.1",
    "monolog/monolog": "^3.0",
    "guzzlehttp/guzzle": "^7.15.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "laravel/pint": "^1.13",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "PiiProtect\\Monolog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PiiProtect\\Monolog\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint --test",
    "analyse": "phpstan analyse --no-progress"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
